{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corlaan Mail Reader output",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "intent", "confidence", "references", "referencesFromQuoted", "sensitive", "instructionSignals"],
  "properties": {
    "language": { "enum": ["nl", "fr", "en", "de", "unknown"] },
    "intent": { "enum": ["wismo", "pod", "slot_change", "invoice", "cancel", "unknown"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value"],
        "properties": {
          "type": { "enum": ["shipment", "cmr", "customer"] },
          "value": { "type": "string", "maxLength": 40 }
        }
      }
    },
    "referencesFromQuoted": { "type": "boolean" },
    "sensitive": { "type": "array", "items": { "enum": ["damage", "dispute", "legal", "anger"] }, "uniqueItems": true },
    "instructionSignals": { "type": "array", "items": { "type": "string", "maxLength": 200 } }
  }
}
